*  cd ../../Users/Asus/Desktop/NGSpice/ckt-inversor/Xyce

.include "finfet.mod"
* Declaração das fontes
.param supply = 0.7

vdd vdd 0 dc 0.7
vin1 in1 0 PULSE (0 0.7 0p 10p 10p 1000p 1000p)
vin2 in2 0 PULSE (0 0. 0p 10p 10p 1000p 1000p)
.tran 0.001p 1000p

Vagingp1 in1 inp1 dc -0.0445
Vagingp2 in2 inp2 dc -0.0445
Vagingn1 in1 inn1 dc 0.0397
Vagingn2 in2 inn2 dc 0.0445


MP1 out     inp1 vdd     vdd pmos_lvt L=20n NFIN=2 
MP2 out     inp2 vdd     vdd pmos_lvt L=20n NFIN=2

MN1 out     inn1 n1      0  nmos_lvt L=20n NFIN=2 
MN2 n1      inn2 0       0   nmos_lvt L=20n NFIN=2 



vaux n1 aux 0
* Positivo

*iexp out dnmos exp(0 10u 50p 2p 65p 4p)
* Negativo
iexp2 aux 0 exp(0 44u 20p 2p 35p 4p)

.OPTION OUTPUT INITIAL_INTERVAL=.1ps 350ps
.PRINT TRAN FORMAT=CSV v(out) v(in1) v(in2) v(n1)
.measure tran valor_maximo MAX v(out) from=0n to=100p
.measure tran valor_minimo MIN v(out) from=0n to=100p
.measure tran valor_min_vn1 MIN v(n1) from=0p to=100p

.end